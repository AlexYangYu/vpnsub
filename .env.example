# Never commit the real file. Generate independent tokens with:
#   ./scripts/generate-secrets.sh
ZOD_SUBSCRIPTION_URL=https://example.invalid/private-zod-subscription
SUBSCRIPTION_TOKEN=replace-with-a-64-character-random-subscription-token
ADMIN_TOKEN=replace-with-a-different-64-character-random-admin-token

STATIC_PROXY_NAMES=LA
MIN_ZOD_NODES=5
FETCH_TIMEOUT_SECONDS=45
FETCH_ATTEMPTS=3
MIHOMO_START_TIMEOUT_SECONDS=15
RETENTION_COUNT=5
UPSTREAM_USER_AGENT=clash.meta
SCHEDULE_HOURS_UTC=0,6,12,18
ENABLE_SCHEDULER=true
REFRESH_ON_START=true
TRUST_CF_CONNECTING_IP=true
SUBSCRIPTION_RATE_PER_HOUR=60
ADMIN_RATE_PER_HOUR=20
ALLOW_INSECURE_UPSTREAM=false
VALIDATE_WITH_MIHOMO=true
